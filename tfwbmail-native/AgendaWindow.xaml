<Window x:Class="TfwbMail.AgendaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="tfwbmail - Agenda" Width="760" Height="560"
        WindowStartupLocation="CenterOwner" Background="#111827" Foreground="White">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Agenda" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBox x:Name="TitleBox" Width="260" Height="38" Margin="24,0,8,0" Padding="8"/>
            <DatePicker x:Name="DateBox" Width="150" Height="38"/>
            <Button Content="Toevoegen" Width="110" Height="38" Margin="8,0,0,0"
                    Background="#315BEA" Foreground="White" BorderThickness="0" Click="AddClick"/>
        </StackPanel>
        <ListBox x:Name="EventList" Grid.Row="1" Background="#1F2937" BorderThickness="0"
                 Foreground="White" MouseDoubleClick="DeleteClick"/>
    </Grid>
</Window>
